# ==============================================================================
# HH Goa 2026 Task 2: Voice-Enabled Sub-200ms RAG Environment Configuration
# ==============================================================================

# STT Provider ("sarvam" or "elevenlabs")
STT_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Ultra-Low-Latency LLM Provider ("groq", "gemini", "openai")
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Latency Target (ms)
LATENCY_TARGET_MS=200.0

# Dataset & Chunking Settings
DATASET_NAME=ai4bharat/MSMARCO-XI
DEFAULT_LANGUAGE=en
DEFAULT_CHUNKING_STRATEGY=recursive_hierarchical

# Guardrail Strictness Thresholds
GROUNDING_THRESHOLD=0.55
SAFETY_TOXICITY_THRESHOLD=0.70
TOPIC_SIMILARITY_THRESHOLD=0.25
